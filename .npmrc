# Project npm settings (personal project).
# Use the PUBLIC npm registry for this project instead of the company Artifactory.
# (Your user ~/.npmrc still points company projects to Artifactory — unaffected.)
registry=https://registry.npmjs.org/
legacy-peer-deps=true
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=600000
