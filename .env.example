# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Tokens are only needed for later phases (connectors). MVP (Git + files) needs none.

# Server
PORT=3001

# Ollama (local AI brain) — default local install
OLLAMA_BASE_URL=http://localhost:11434

# Confluence (Phase 2)
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=

# GitLab / GitHub (Phase 2)
GITLAB_BASE_URL=
GITLAB_PAT=
GITHUB_PAT=

# ValueEdge (Phase 3)
VALUEEDGE_API_KEY=
VALUEEDGE_API_SECRET=
